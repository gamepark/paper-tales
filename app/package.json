{
  "name": "@gamepark/paper-tales-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The user interface of Paper Tales adaptation for Game Park",
  "author": "Romain Fromi <romain@game-park.com> (https://game-park.com/)",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:hashed": "rclone copy dist paper-tales:paper-tales.game-park.com --progress --s3-acl=public-read --include \"assets/**\" -M --metadata-set \"cache-control=public, max-age=31536000, immutable\"",
    "sync:other": "rclone sync dist paper-tales:paper-tales.game-park.com --progress --s3-acl=public-read --exclude \"assets/**\" --ignore-times -M --metadata-set \"cache-control=no-cache\"",

    "sync:clean": "rclone sync dist paper-tales:paper-tales.game-park.com --progress --s3-acl=public-read --include \"assets/**\" -M --metadata-set \"cache-control=public, max-age=31536000, immutable\"",
    "sync": "npx rimraf dist/assets/*.map && yarn sync:hashed && yarn sync:other && yarn sync:clean",
    "deploy": "yarn build && yarn sync"
  },
  "dependencies": {
    "@dnd-kit/core": "~6.3.1",
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@gamepark/avataaars": "^3.0.0",
    "@gamepark/react-game": "~7.7.27",
    "@gamepark/rules-api": "~7.6.3",
    "es-toolkit": "^1.47.0",
    "i18next": "^25.10.10",
    "intl-messageformat": "^11.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.6.6",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-imagetools": "^10.0.0",
    "vitest": "^4.1.8"
  }
}
